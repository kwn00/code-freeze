# 서버 포트
PORT=8787
# 세션 토큰 서명용 HMAC 시크릿. 프로덕션에서는 반드시 32자 이상 랜덤 값 (없으면 프로덕션 기동 거부)
SESSION_SECRET=
# 추가로 허용할 Origin (쉼표 구분). 기본은 same-origin 만 허용
ALLOWED_ORIGINS=

# ── 클라이언트 IP (IP 당 연결 수 · 세션 발급 레이트리밋) ──
# 엣지/CDN 이 덮어쓰는 단일 값 헤더 이름. Render/Cloudflare 는 cf-connecting-ip
CLIENT_IP_HEADER=
# X-Forwarded-For 를 붙이는 신뢰 프록시 홉 수 (맨 앞 값은 위조 가능하므로 쓰지 않는다)
TRUST_PROXY=0

# 리더보드 PostgreSQL 주소 (Neon). 비워 두면 기록은 서버 메모리에만 있다.
# 예: postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require  (커밋하지 말 것)
DATABASE_URL=
